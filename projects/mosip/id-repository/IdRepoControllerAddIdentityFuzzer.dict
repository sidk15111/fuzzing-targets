# Tokens for the identity request envelope and the values the validator
# actually compares against. Without these, random mutation almost never
# produces a valid "id"/"version"/"status" and the fuzzer is stuck at the
# first reject branch.
"\"id\""
"\"version\""
"\"requesttime\""
"\"metadata\""
"\"request\""
"\"registrationId\""
"\"status\""
"\"identity\""
"\"documents\""
"\"verifiedAttributes\""
"\"IDSchemaVersion\""
"\"UIN\""
"\"category\""
"\"value\""
"\"language\""
"\"mosip.id.create\""
"\"mosip.id.update\""
"\"mosip.id.read\""
"\"v1\""
"\"ACTIVATED\""
"\"BLOCKED\""
"\"DEACTIVATED\""
"\"proofOfAddress\""
"\"proofOfIdentity\""
"\"fullName\""
"null"
"true"
"false"
"{}"
"[]"
